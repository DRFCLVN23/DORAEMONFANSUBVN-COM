rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null &&
         request.auth.token.email.lower() == 'tuankhaimoi12345@gmail.com') ||
        request.auth.token.admin == true
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          (request.auth.token.email != null &&
           exists(/databases/$(database)/documents/admins/$(userEmail())))
        )
      );
    }

    function isNotBanned() {
      return isSignedIn() &&
        !exists(/databases/$(database)/documents/banned_users/$(request.auth.uid)) &&
        (request.auth.token.email == null ||
         !exists(/databases/$(database)/documents/banned_users/$(userEmail())));
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ============================================================
    // 1. PHIM: Công khai xem, Admin toàn quyền, người dùng/khách tăng views
    // ============================================================
    match /movies/{movieId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || changedKeys().hasOnly(['views']);
    }

    // ============================================================
    // 2. BÌNH LUẬN PHIM: Xem công khai, bình luận/trả lời/cảm xúc
    // ============================================================
    match /movie_comments/{commentId} {
      allow read: if true;
      allow create: if isNotBanned() && request.resource.data.userId == request.auth.uid;
      allow update: if isNotBanned() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        changedKeys().hasOnly(['replies']) ||
        changedKeys().hasOnly(['emotions'])
      );
      allow delete: if isNotBanned() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ============================================================
    // 3. DANH SÁCH BỊ CẤM: Khách/user xem trạng thái của mình, Admin quản trị
    // ============================================================
    match /banned_users/{documentId} {
      allow get: if isSignedIn() && (
        request.auth.uid == documentId ||
        userEmail() == documentId.lower() ||
        isAdmin()
      );
      allow list, write: if isAdmin();
    }

    // ============================================================
    // 4. DANH SÁCH IP BỊ CẤM: Khách đọc IP của mình, Admin quản trị
    // ============================================================
    match /banned_ips/{ip} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // ============================================================
    // 5. DANH SÁCH ADMIN: BẢO VỆ TUYỆT ĐỐI - User xem doc của mình, Admin quản trị
    // ============================================================
    match /admins/{adminId} {
      allow get: if isSignedIn() && (
        request.auth.uid == adminId ||
        userEmail() == adminId.lower() ||
        isAdmin()
      );
      allow list, write: if isAdmin();
    }

    // ============================================================
    // 6. THÔNG TIN NGƯỜI DÙNG: BẢO MẬT TUYỆT ĐỐI
    // Chỉ chính chủ hoặc Admin mới được xem (get) thông tin cá nhân.
    // Chỉ Admin mới được duyệt danh sách (list), chặn hoàn toàn cào data.
    // ============================================================
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if (isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.email == request.auth.token.email) ||
        isAdmin()
      ));
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId &&
          changedKeys().hasOnly([
            'displayName', 'photoURL', 'lastSeen', 'lastIp',
            'updatedAt', 'shortId', 'googleId', 'providerData',
            'email', 'twoFactor', 'createdAt', 'bio'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // ============================================================
    // 7. BÀI VIẾT (POSTS): Người dùng đăng bài, thích, bình luận, sửa bài
    // ============================================================
    match /posts/{postId} {
      allow read: if true;

      allow create: if isNotBanned() && (
        isAdmin() || (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.pinned == false &&
          request.resource.data.totalLikes == 0 &&
          request.resource.data.likes == 0 &&
          request.resource.data.liked == false
        )
      );

      allow update: if isNotBanned() && (
        isAdmin() ||
        ((resource.data.userId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.userEmail == request.auth.token.email)) &&
         changedKeys().hasOnly(['content', 'fileUrl', 'fileType', 'updatedAt'])) ||
        changedKeys().hasOnly(['comments']) ||
        changedKeys().hasOnly(['likedBy', 'totalLikes', 'likes', 'liked'])
      );

      allow delete: if isNotBanned() && (
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.userEmail == request.auth.token.email) ||
        isAdmin()
      );
    }

    // ============================================================
    // 8. SỰ KIỆN: Xem công khai, Admin quản lý, khách/user tăng views
    // ============================================================
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || changedKeys().hasOnly(['views']);
    }

    // ============================================================
    // 9. BÁO LỖI: Ai cũng có thể gửi báo lỗi, Admin xem và xử lý
    // ============================================================
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ============================================================
    // 10. Chặn tất cả các đường dẫn còn lại
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
