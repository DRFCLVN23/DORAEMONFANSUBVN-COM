rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {
    match /movies/{movieId} {
      allow read: if true;
      allow update: if request.auth != null;
    }

    match /movie_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.movieId is string
        && (request.resource.data.text is string || request.resource.data.images is list)
        && request.resource.data.displayName is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && (resource.data.userId == request.auth.uid || request.resource.data.emotions is map || request.resource.data.replies is list);
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /banned_users/{email} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if true;
    }

    // Collection bài viết newsfeed
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Sub-collection comments của bài viết
    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}


